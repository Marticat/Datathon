# Copy to .env and edit. All variables are optional.
CQA_DATABASE_URL=sqlite:///./cqa.db
# CQA_DATABASE_URL=postgresql+psycopg://cqa:cqa@localhost:5432/cqa
CQA_CORS_ORIGINS=*

# Organizer API: paste the URL behind the "Открыть GET для DEV" button WITHOUT the ?group_id=... part.
# Empty => mock mode (bundled sample data, clearly marked MOCK).
CQA_ORGANIZER_API_URL=
CQA_ORGANIZER_DEV_GROUP_ID=DEV
# Announced by organizers ~23h after start (or pass {"group_id": "..."} to POST /api/v1/ingestion/control)
CQA_ORGANIZER_CONTROL_GROUP_ID=
# auto | mock | live
CQA_ORGANIZER_MODE=auto
